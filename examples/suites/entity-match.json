      ]
    },
    {
      "id": "e14",
      "state": {
        "record_a": {
          "name": "Levi's 501 Original Fit Jeans, 32x32, Dark Stonewash"
        },
        "record_b": {
          "name": "Levis 501 Original jeans W32 L32 dark stonewash"
        }
      },
      "expect": {
        "same": true
      },
      "tags": [
        "en"
      ]
    }
  ]
}
