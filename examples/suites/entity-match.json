        "record_a": {
          "name": "The Coca-Cola Company",
          "ticker": "KO"
        },
        "record_b": {
          "name": "Coca-Cola Europacific Partners",
          "ticker": "CCEP"
        }
      },
      "expect": {
        "same": false
      },
      "tags": [
        "en"
      ]
    },
    {
      "id": "e10",
      "state": {
        "record_a": {
          "name": "Alphabet Inc.",
          "hq": "Mountain View"
        },
        "record_b": {
          "name": "Google LLC parent company",
          "hq": "Mountain View, California"
        }
      },
      "expect": {
