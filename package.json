{
  "name": "jevtool",
  "version": "0.2.2",
  "description": "Test Jev judgments against labeled cases, check agent deliveries, and filter records by meaning.",
  "type": "module",
  "bin": {
    "jevtool": "bin/jevtool.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node bin/jevtool.mjs demo",
    "check": "node --check bin/jevtool.mjs"
  },
  "license": "MIT",
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "llm",
    "eval",
    "classification",
    "claude-code",
    "agents",
    "cli"
  ],
  "homepage": "https://jevtool.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jevtool/jevtool.git"
  },
  "bugs": {
    "url": "https://github.com/jevtool/jevtool/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/eval.mjs",
    "./eval-core": "./src/eval-core.mjs",
    "./client": "./src/client.mjs",
    "./package.json": "./package.json"
  }
}
